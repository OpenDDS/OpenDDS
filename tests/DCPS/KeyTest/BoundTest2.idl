#include "tao/StringSeq.pidl"
#include "tao/FloatSeq.pidl"

// Struct with all simple bounded fields
module Bound {

  // Bounded sequence of bounded type
#pragma DCPS_DATA_TYPE "Bound::BoundedSequenceOfBoundedMessage"

  typedef sequence<float, 20> BoundedFloatSeq;

  struct BoundedSequenceOfBoundedMessage {
    BoundedFloatSeq float_seq;
  };

  // Unbounded sequence of bounded type
#pragma DCPS_DATA_TYPE "Bound::UnboundedSequenceOfBoundedMessage"

  typedef sequence<float> UnboundedFloatSeq;

  struct UnboundedSequenceOfBoundedMessage {
    UnboundedFloatSeq float_seq;
  };

  // Bounded sequence of unbounded type
#pragma DCPS_DATA_TYPE "Bound::BoundedSequenceOfUnboundedMessage"

  typedef sequence<string, 20> BoundedStringSeq;

  struct BoundedSequenceOfUnboundedMessage {
    BoundedStringSeq string_seq;
  };

  // Unbounded sequence of unbounded type
#pragma DCPS_DATA_TYPE "Bound::UnboundedSequenceOfUnboundedMessage"

  typedef sequence<string> UnboundedStringSeq;

  struct UnboundedSequenceOfUnboundedMessage {
    UnboundedStringSeq string_seq;
  };

  // Union of bounded types
#pragma DCPS_DATA_TYPE "Bound::BoundedUnionMessage"

  union BoundedUnion switch (short) {
  case 1: float float_field;
  case 2: long long_field;
  default: short short_field;
  };

  struct BoundedUnionMessage {
    BoundedUnion union_field;
  };

  // Union of unbounded types
#pragma DCPS_DATA_TYPE "Bound::UnboundedUnionMessage"

  union UnboundedUnion switch (short) {
  case 1: string string_field;
  case 2: long long_field;
  default: short short_field;
  };

  struct UnboundedUnionMessage {
    UnboundedUnion union_field;
  };

  // Recursive type definition (unbounded)
#pragma DCPS_DATA_TYPE "Bound::RecursiveMessage"

  struct RecursiveMessage;

  typedef sequence<RecursiveMessage, 1> SingleMessageSeq;

  union NestedMessageUnion switch (short) {
  case 1: SingleMessageSeq message;
  case 2: long long_field;
  default: short short_field;
  };

  struct RecursiveMessage {
    NestedMessageUnion union_field;
    float float_field;
  };

  // An appendable struct of bounded fields should be bounded -- appendable
  // only adds a DHEADER (XCDR2), no per-member overhead.
#pragma DCPS_DATA_TYPE "Bound::AppendableBoundedMessage"

  @appendable
  struct AppendableBoundedMessage {
    long long_field;
    short short_field;
  };

  // A mutable struct of bounded fields should also be bounded, accounting
  // for each member's own parameter-list header (PID for XCDR1, EMHEADER for
  // XCDR2) in addition to the DHEADER.
#pragma DCPS_DATA_TYPE "Bound::MutableBoundedMessage"

  @mutable
  struct MutableBoundedMessage {
    @id(0) long long_field;
    @id(1) short short_field;
  };

  // A member id >= 0x4000 forces the 12-byte XCDR1 "extended" parameter
  // header (XCDR2's EMHEADER has no id-based extension).
#pragma DCPS_DATA_TYPE "Bound::MutableExtendedIdMessage"

  @mutable
  struct MutableExtendedIdMessage {
    @id(20000) long long_field;
  };

  // A member whose own max size is >= 65536 bytes also forces the 12-byte
  // XCDR1 extended header, independent of its id; XCDR2 instead needs the
  // 4-byte NEXTINT since the size isn't 1, 2, 4, or 8 bytes.
  typedef string<70000> Big70kString;

#pragma DCPS_DATA_TYPE "Bound::MutableExtendedSizeMessage"

  @mutable
  struct MutableExtendedSizeMessage {
    @id(0) Big70kString big_field;
  };

  // Mutable union -- the discriminator and each branch get their own
  // parameter-list header; the bound is the largest branch.
#pragma DCPS_DATA_TYPE "Bound::MutableBoundedUnionMessage"

  @mutable
  union MutableBoundedUnion switch (short) {
  case 1: @id(0) long long_field;
  default: @id(1) short short_field;
  };

  struct MutableBoundedUnionMessage {
    MutableBoundedUnion union_field;
  };

  // The types below use @topic/@key annotations directly instead of the
  // legacy DCPS_DATA_TYPE/DCPS_DATA_KEY pragmas above, since key-only
  // bounds and the XCDR2 member-header cases below only apply to that path.

  // A mutable key-only bound has to account for each key field's own
  // parameter-list header too, not just concatenate the key fields' sizes.
  @topic
  @mutable
  struct MutableKeyMessage {
    @key long key_field;
    long other_field;
  };

  // XCDR2's EMHEADER uses a compact 4-byte form only when a member's payload
  // is exactly 1, 2, 4, or 8 bytes; a variable-size member's maximum payload
  // can be one of those sizes while a smaller, still-valid payload isn't, so
  // the bound has to assume the larger 8-byte NEXTINT form for any
  // variable-size member, not just size the header off the maximum payload.
  @topic
  @mutable
  struct VariableMutableMessage {
    string<3> value;
  };

  @topic
  @mutable
  union VariableMutableUnion switch (short) {
  case 1: string<3> value;
  default: short short_field;
  };

  // A mutable union's KeyOnly/NestedKeyOnly serialization always ends with
  // the XCDR1 list-end sentinel (see gen_union_key_serializers()), even
  // when, as here, the key (the discriminator) is the union's only content.
  @topic
  @mutable
  union MutableKeyUnion switch (@key short) {
  case 0: long value;
  };

  // A struct that's itself only a key because it's an element of a
  // sequence key (see NestedSeqKeyMessage below); its own sequence key
  // field has to keep contributing to the ordering instead of being
  // silently skipped just because it's nested one level deeper.
  @topic
  @final
  struct NestedSeqKeyElement {
    @key sequence<long, 2> value;
  };

  @topic
  @final
  struct NestedSeqKeyMessage {
    @key sequence<NestedSeqKeyElement, 2> value;
  };

  // This file doesn't use -Lc++11, so this exercises the classic C++
  // mapping's sequence<string>/sequence<wstring> element access.
  @topic
  @final
  struct StringSeqKeyMessage {
    @key sequence<string, 2> value;
  };

#ifndef OPENDDS_SAFETY_PROFILE
  @topic
  @final
  struct WStringSeqKeyMessage {
    @key sequence<wstring, 2> value;
  };
#endif

};
